<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Caelum.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        The settings are laid out as a single centred column of section headers and
        settings cards, the same arrangement Auto Dark Mode uses. A card carries its
        label on the left and its control on the right; cards whose control needs the
        full width opt into the vertical alignment instead.
    -->
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageBaseStackPanelStyle}">

            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <!-- Account -->
            <TextBlock
                x:Name="AccountCaption"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

            <controls:SettingsCard>
                <controls:SettingsCard.Header>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <PersonPicture
                            x:Name="Avatar"
                            Width="40"
                            Height="40" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                x:Name="AccountName"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="AccountEmail"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </controls:SettingsCard.Header>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        x:Name="AuthButton"
                        Content="Sign in"
                        Click="OnAuthTapped" />

                    <!--
                        Shown instead of the sign-in button while no Entra application has been
                        registered for this build, so the account card never offers a control
                        that cannot work.
                    -->
                    <TextBlock
                        x:Name="AuthComingSoon"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- General -->
            <TextBlock
                x:Name="GeneralCaption"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

            <controls:SettingsCard>
                <controls:SettingsCard.Header>
                    <TextBlock x:Name="IdentityCaption" Style="{StaticResource SettingsCardHeaderTextBlockStyle}" />
                </controls:SettingsCard.Header>
                <ComboBox x:Name="IdentityOptions" MinWidth="200" SelectionChanged="OnIdentityChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard
                ContentAlignment="Vertical"
                HorizontalContentAlignment="Stretch">
                <controls:SettingsCard.Header>
                    <TextBlock x:Name="RegionCaption" Style="{StaticResource SettingsCardHeaderTextBlockStyle}" />
                </controls:SettingsCard.Header>

                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="RegionBox"
                            HorizontalAlignment="Stretch"
                            AcceptsReturn="False"
                            LostFocus="OnRegionLostFocus" />

                        <Button
                            x:Name="LocateButton"
                            Grid.Column="1"
                            Click="OnLocate">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE707;" />
                                <TextBlock x:Name="LocateCaption" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressRing
                        x:Name="LocateProgress"
                        Width="20"
                        Height="20"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="LocateMessage"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard
                ContentAlignment="Vertical"
                HorizontalContentAlignment="Stretch">
                <controls:SettingsCard.Header>
                    <TextBlock x:Name="SubjectsCaption" Style="{StaticResource SettingsCardHeaderTextBlockStyle}" />
                </controls:SettingsCard.Header>
                <ItemsControl x:Name="SubjectGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </controls:SettingsCard>

            <!-- Appearance -->
            <TextBlock
                x:Name="AppearanceCaption"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

            <controls:SettingsCard>
                <controls:SettingsCard.Header>
                    <TextBlock x:Name="DarkCaption" Style="{StaticResource SettingsCardHeaderTextBlockStyle}" />
                </controls:SettingsCard.Header>
                <ComboBox x:Name="ThemeOptions" MinWidth="200" SelectionChanged="OnThemeChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard>
                <controls:SettingsCard.Header>
                    <TextBlock x:Name="LanguageCaption" Style="{StaticResource SettingsCardHeaderTextBlockStyle}" />
                </controls:SettingsCard.Header>
                <ComboBox
                    x:Name="LanguageBox"
                    MinWidth="240"
                    SelectionChanged="OnLanguageChanged" />
            </controls:SettingsCard>

            <!--
                The restart hint and the button sit below the card rather than inside it,
                because they only make sense together when the language actually changed.
            -->
            <StackPanel Spacing="8" Margin="0,4,0,0">
                <TextBlock
                    x:Name="LanguageHint"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <Button
                    x:Name="RestartButton"
                    Click="OnRestartClicked"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- About -->
            <TextBlock
                x:Name="AboutCaption"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

            <controls:SettingsCard>
                <controls:SettingsCard.Header>
                    <TextBlock
                        x:Name="VersionText"
                        Style="{StaticResource SettingsCardHeaderTextBlockStyle}"
                        TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
            </controls:SettingsCard>

            <controls:SettingsCard>
                <controls:SettingsCard.Header>
                    <TextBlock
                        x:Name="SloganText"
                        Style="{StaticResource SettingsCardHeaderTextBlockStyle}"
                        TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="ReadmeLink"
                IsClickEnabled="True"
                Click="OnReadmeClick">
                <controls:SettingsCard.ActionIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="ReleaseLink"
                IsClickEnabled="True"
                Click="OnReleaseClick">
                <controls:SettingsCard.ActionIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="IssueLink"
                IsClickEnabled="True"
                Click="OnIssueClick">
                <controls:SettingsCard.ActionIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="PrivacyLink"
                IsClickEnabled="True"
                Click="OnPrivacyClick">
                <controls:SettingsCard.ActionIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>

</Page>