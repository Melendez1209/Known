<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Known.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.expression.blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Known">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The TitleBar control replaces the system title bar and reserves room for the caption
            buttons itself, so no manual inset padding is needed. NavigationView.IsTitleBarAutoPaddingEnabled,
            left at its default, is what pulls the pane header up so the two read as one continuous
            surface.

            The back button is provided by the TitleBar itself, following the Fluent Design guideline
            that the back button sits in the top-left corner of the window. IsBackButtonEnabled is
            bound to MainFrame.CanGoBack so the button is only usable when there is somewhere to go.
        -->
        <TitleBar
            x:Name="AppTitleBar"
            IsPaneToggleButtonVisible="True"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="{x:Bind MainFrame.CanGoBack, Mode=OneWay}"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            NavigationView drives the top-level tabs. The back button is no longer here: it belongs to
            the TitleBar above, matching the WinUI Notes sample and the Fluent Design guidance.
        -->
        <NavigationView
            Grid.Row="1"
            x:Name="Navigation"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="OnTabSelectionChanged"
            DisplayModeChanged="OnDisplayModeChanged">

            <!--
                Home and History are the two day-to-day destinations. Account is somewhere the student
                returns to rather than works in, so it sits below with About.
            -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="Home" Icon="Home" />
                <NavigationViewItem x:Name="HistoryItem" Content="History" Tag="History" Icon="AllApps" />
            </NavigationView.MenuItems>

            <!--
                About sits here rather than at the top because it is a single page with nothing to
                choose between once you are there. The account page lists it as one of its rows too,
                which is deliberate.

                Settings needs no item of its own: NavigationView contributes one below these footer
                items, which IsSettingsVisible shows by default. The control generates it, so it is
                not one of ours and carries no Tag. OnTabSelectionChanged picks it up through
                IsSettingsSelected instead, and ApplyCaptions renames it, because the caption the
                control gives it does not follow the language picked in the app.
            -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AccountItem" Content="Account" Tag="Account" Icon="Contact" />
                <NavigationViewItem x:Name="AboutItem" Content="About" Tag="About" Icon="Help" />
            </NavigationView.FooterMenuItems>

            <!--
                The single main frame holds every page and its children. Grid children paint in
                declaration order, so this frame is listed last so it paints on top of nothing else
                and fills the content area.
            -->
            <Frame x:Name="MainFrame" />
        </NavigationView>
    </Grid>

</Window>
