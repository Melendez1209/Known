<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Known.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Known">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The TitleBar control replaces the system title bar and reserves room for the caption
            buttons itself, so no manual inset padding is needed. NavigationView.IsTitleBarAutoPaddingEnabled,
            left at its default, is what pulls the pane header up so the two read as one continuous
            surface.

            The back button is not one of this control's jobs. It belongs to the NavigationView below,
            which draws it and reports the request, the arrangement the WinUI Gallery sample uses.
            Only the pane toggle is kept here, and the NavigationView's own toggle is therefore
            hidden, because having the same button twice in one column would duplicate them.
        -->
        <TitleBar
            x:Name="AppTitleBar"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The back button is the NavigationView's own, and BackRequested is the only thing needed
            to hear it, which is how the WinUI Gallery sample wires the same control. Visible rather
            than Auto, because Auto collapses the button on Xbox and TV and this app is never one:
            naming it outright keeps the pane the same shape everywhere. Whether the button is usable
            is IsBackEnabled's business, and UpdateBackButton answers it from the shell.
        -->
        <NavigationView
            Grid.Row="1"
            x:Name="Navigation"
            PaneDisplayMode="Auto"
            BackRequested="OnNavigationBackRequested"
            IsBackButtonVisible="Visible"
            IsBackEnabled="False"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="OnTabSelectionChanged"
            DisplayModeChanged="OnDisplayModeChanged">

            <!--
                Only the two destinations that make up the exam workflow sit at the top. The account
                is somewhere the student returns to rather than works in, so it goes below with about.
            -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="Home" Icon="Home" />
                <NavigationViewItem x:Name="HistoryItem" Content="History" Tag="History" Icon="AllApps" />
            </NavigationView.MenuItems>

            <!--
                About sits here rather than at the top because it is a single page with nothing to
                choose between once you are there. The account page lists it as one of its rows too,
                which is deliberate.

                Settings needs no item of its own: NavigationView contributes one below these footer
                items, which IsSettingsVisible shows by default. The control generates it, so it is
                not one of ours and carries no Tag. OnTabSelectionChanged picks it up through
                IsSettingsSelected instead, and ApplyCaptions renames it, because the caption the
                control gives it does not follow the language picked in the app.
            -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AccountItem" Content="Account" Tag="Account" Icon="Contact" />
                <NavigationViewItem x:Name="AboutItem" Content="About" Tag="About" Icon="Help" />
            </NavigationView.FooterMenuItems>

            <!--
                The shared frame is declared last on purpose. Grid children paint in declaration
                order, so a frame listed first is painted under the tab frames and would stay hidden
                behind them even once made visible. Collapsed here because ShellNavigator reveals it
                when a page belonging to no tab, such as the settings, is opened.
            -->
            <Grid>
                <Frame x:Name="HomeFrame" />
                <Frame x:Name="HistoryFrame" Visibility="Collapsed" />
                <Frame x:Name="AccountFrame" Visibility="Collapsed" />
                <Frame x:Name="RootFrame" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>

</Window>