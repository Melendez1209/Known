<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Layout tokens shared by the settings pages, following the Windows 11 Settings
        arrangement used by Auto Dark Mode: a single centred column, a thin gap between
        cards and a bold section header above each group.
    -->

    <x:Double x:Key="PageContentMaxWidth">1000</x:Double>
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <Style x:Key="PageBaseStackPanelStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="{StaticResource PageContentMaxWidth}" />
        <Setter Property="Margin" Value="24,0,24,24" />
        <Setter Property="Spacing" Value="{StaticResource SettingsCardSpacing}" />
    </Style>

    <Style
        x:Key="SettingsSectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,28,0,4" />
    </Style>

    <Style
        x:Key="SettingsCardHeaderTextBlockStyle"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>