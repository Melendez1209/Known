<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Known.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Known">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The TitleBar control replaces the system title bar and reserves room for the caption
            buttons itself, so no manual inset padding is needed. It also owns the back and pane
            toggle buttons, which the NavigationView below therefore hides: having them in both
            places would duplicate them. NavigationView.IsTitleBarAutoPaddingEnabled, left at its
            default, is what pulls the pane header up so the two read as one continuous surface.

            IsBackButtonVisible takes a bool on the TitleBar control, whereas the identically named
            NavigationView property is the UWP NavigationViewBackButtonVisible enum. The two are
            unrelated types, so "Collapsed" is correct below and rejected here at run time.
        -->
        <TitleBar
            x:Name="AppTitleBar"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            BackRequested="OnTitleBarBackRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            Grid.Row="1"
            x:Name="Navigation"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="OnTabSelectionChanged"
            DisplayModeChanged="OnDisplayModeChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="Home" Icon="Home" />
                <NavigationViewItem x:Name="HistoryItem" Content="History" Tag="History" Icon="AllApps" />
                <NavigationViewItem x:Name="AccountItem" Content="Me" Tag="Account" Icon="Contact" />
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="RootFrame" Visibility="Collapsed" />
                <Frame x:Name="HomeFrame" />
                <Frame x:Name="HistoryFrame" Visibility="Collapsed" />
                <Frame x:Name="AccountFrame" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>

</Window>