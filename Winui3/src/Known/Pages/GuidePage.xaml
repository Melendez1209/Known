<?xml version="1.0" encoding="utf-8"?>
<local:KnownPage
    x:Class="Known.Pages.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Known.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            x:Name="WelcomeText"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Welcome to Known" />

        <TextBlock
            Grid.Row="1"
            x:Name="DescriptionText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            Text="Tell us a little about yourself for a better experience" />

        <!--
            A plain FlipView rather than a PipsPager: PipsPager exposes its Items collection as a
            static, so pages added by one instance would leak into the next. The dots are drawn by
            hand in the row below, which also makes the active one easy to restyle.
        -->
        <FlipView
            Grid.Row="2"
            x:Name="Pager"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            SelectionChanged="OnPageChanged" />

        <ItemsControl
            Grid.Row="3"
            x:Name="Dots"
            HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">
            <Button x:Name="SkipButton" Content="Skip" Click="OnSkip" />
            <Button
                x:Name="PrimaryButton"
                Style="{StaticResource AccentButtonStyle}"
                Content="Next"
                Click="OnPrimaryAction" />
        </StackPanel>
    </Grid>

</local:KnownPage>
