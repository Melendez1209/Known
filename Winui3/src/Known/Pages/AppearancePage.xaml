<?xml version="1.0" encoding="utf-8"?>

<local:KnownPage
    x:Class="Known.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Known.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            x:Name="TitleText"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Look &amp; feel" />

        <StackPanel Grid.Row="1" Spacing="16">

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="DarkCaption"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Dark theme" />

                <RadioButtons
                    x:Name="ThemeOptions"
                    SelectionChanged="OnThemeChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <ToggleSwitch
                    x:Name="HighContrastToggle"
                    Header="High contrast dark theme"
                    Toggled="OnHighContrastToggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="LanguageCaption"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Display language" />

                <ComboBox
                    x:Name="LanguageBox"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnLanguageChanged" />

                <TextBlock
                    x:Name="LanguageHint"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Grid>

</local:KnownPage>